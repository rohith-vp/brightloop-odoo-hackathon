# Copy this file to .env for local development.
# Replace development placeholders locally. Never commit .env or real credentials.

# Database (PostgreSQL)
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://brightloop:change-me-local-only@db:5432/brightloop

# Backend
API_HOST=0.0.0.0
API_PORT=8000
# Use a long, random value in your local .env. Do not use this placeholder in production.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend (Vite exposes VITE_* values to the browser; never put secrets here)
WEB_HOST=0.0.0.0
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# CORS: adjust if your frontend runs on a different origin
CORS_ORIGINS=http://localhost:5173

# Optional application settings
APP_ENV=development
LOG_LEVEL=debug
